# ---------------------------------------------------------------------------
# ICOF Global University — environment
#
# Copy to .env.local for development, and set the same variables in the Vercel
# project for production. Nothing here has a default that is safe to ship: the
# fallbacks in the code exist so the app keeps running during the switchover,
# not because they are correct.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# The Supabase project. Both variables must point at the SAME project: the
# browser client and the approval route read the URL from one place precisely
# so an account cannot be created in one database while a status is updated in
# another.
# These two now default to the university's project in code, so they only need
# setting to point a deployment somewhere else — a staging database, say.
NEXT_PUBLIC_SUPABASE_URL=https://bhpsftesricwotkziokd.supabase.co

# The anon / publishable key. This is public by design — it reaches every
# visitor's browser — and is safe there ONLY because row-level security decides
# what it can read. Find it under Project Settings → API → Project API keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_lQm8dFmj8PnQinSZooQbVg_WAfKJcGS

# The service role key. NEVER prefix this NEXT_PUBLIC_, never commit it, and
# never paste it into a client component. It bypasses row-level security on
# every table in the database. It is used in exactly one place —
# src/app/api/admissions/approve/route.ts — to create a student's auth account
# at the moment the Registrar approves them. Without it, approval refuses
# rather than silently creating no account.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email -----------------------------------------------------------------
# Used for the application notification to Admissions and for the welcome email
# carrying a new student's credentials. If these are unset the account is still
# created, but the applicant is not told and the desk warns the Registrar.
# cPanel mail for iguc.net. Port 465 means implicit TLS; the code sets
# secure:true only for 465, so use 465 or 587 and nothing else.
SMTP_HOST=mail.iguc.net
SMTP_PORT=465
SMTP_USER=registrar@iguc.net
SMTP_PASS=

# The address students see in the From line. Optional — defaults to SMTP_USER.
# Set it only when the authenticating mailbox differs from the address the
# university wants to be seen sending from, and only to a domain whose SPF
# authorises this mail server. A mismatch reads as forged to receiving servers,
# and a student receiving their password from an unfamiliar address has been
# handed something indistinguishable from phishing.
MAIL_FROM=

# Where a submitted application is sent.
APPLY_TO=admissions@iguc.net

# --- Site ------------------------------------------------------------------
# Used to build the portal link inside the welcome email.
SITE_URL=https://iguc.net

# --- Demo ------------------------------------------------------------------
# Set to 'true' ONLY in a non-production environment. It enables one-click
# demo logins in the portal, which bypass authentication entirely.
NEXT_PUBLIC_ENABLE_DEMO=false


# ---------------------------------------------------------------------------
# CREDENTIAL_SECRET — REQUIRED before any transcript or certificate is issued
#
# The HMAC key behind the QR code on every transcript and degree certificate.
# It is what makes /verify mean anything.
#
# THIS USED TO HAVE A FALLBACK. The signing route read
#   process.env.CREDENTIAL_SECRET ?? 'iguc-credential-dev-secret'
# so with the variable unset — the state of any deployment where nobody set it
# — the signing key was a string committed to a public repository. Anyone who
# read the file could mint signatures offline, indefinitely, and the
# university's own /verify page would confirm the resulting document as
# genuine. There is no fallback now: signing and verification both refuse
# without this, which is the correct way to fail.
#
# Generate one and never reuse it elsewhere:
#   openssl rand -hex 32
#
# Minimum 32 characters; the route rejects anything shorter.
#
# CHANGING IT INVALIDATES EVERY CREDENTIAL ALREADY ISSUED. Signatures are
# computed from it, so a rotation makes every QR code printed under the old key
# fail verification — on documents already in graduates' hands. Rotate only in
# response to a compromise, and be prepared to reissue.
# ---------------------------------------------------------------------------
CREDENTIAL_SECRET=


# ---------------------------------------------------------------------------
# SECRET_STORE_KEY — REQUIRED before any social account can be connected
#
# Seals every stored OAuth token with AES-256-GCM. The ciphertext lives in
# `secret_store`; the key lives only here. A database dump is therefore
# ciphertext, and a leaked dump is not a leaked token.
#
# THE CONNECT FLOW REFUSES WITHOUT IT, before sending anybody to a consent
# screen — obtaining a permission it cannot store would be worse than not
# offering the button.
#
#   openssl rand -base64 48
#
# Minimum 24 characters.
#
# IT IS DELIBERATELY NOT CREDENTIAL_SECRET. Rotating this one costs an
# afternoon of re-authorising six social connections. Rotating CREDENTIAL_SECRET
# invalidates every certificate the university has ever issued. Keeping them
# separate is what makes this one rotatable at all.
# ---------------------------------------------------------------------------
SECRET_STORE_KEY=

# Where every provider sends the administrator back after consent. Register the
# SAME string with each of the six applications below. A mismatch here is the
# commonest cause of a failed connection — the provider's own words are carried
# back to the screen so you can read what it objected to.
SOCIAL_REDIRECT_URI=https://iguc.net/api/social/oauth/callback


# ---------------------------------------------------------------------------
# THE SIX SOCIAL APPLICATIONS
#
# None of these can be generated. Each is an application the University
# registers in its own name, reviewed by the platform, and granted specific
# permissions. docs/SOCIAL-CONNECTIONS.md lists the exact scopes, what takes
# weeks, and the thing that catches people out on each network.
#
# A network with no application set is not offered as a destination. Nothing
# fails silently, and nothing is ever reported as published when it was not.
# ---------------------------------------------------------------------------

# Facebook, Instagram and Threads — ONE Meta app covers all three.
META_APP_ID=
META_APP_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# YouTube, via a Google Cloud project with YouTube Data API v3 enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Per-network redirect overrides. Leave unset — SOCIAL_REDIRECT_URI covers all
# six. Set one only if a provider forces a different address on you.
# META_REDIRECT_URI=
# X_REDIRECT_URI=
# LINKEDIN_REDIRECT_URI=
# GOOGLE_REDIRECT_URI=
# TIKTOK_REDIRECT_URI=


# ---------------------------------------------------------------------------
# LIVE PROCTORING — required to WATCH an examination, not to sit one
#
# Without these, everything else in the examination system works: eligibility,
# identity and device checks, the central clock, autosave, events, incidents,
# findings, marking, moderation and the audit trail. Examinations can be sat and
# marked; they cannot be watched live, and the console says so rather than
# drawing a camera panel with nothing behind it.
#
# LiveKit is the only provider with an adapter in this system. It is also the
# only one that can be self-hosted, which is the sole option that keeps
# recordings of students' homes on infrastructure the University controls.
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# ---------------------------------------------------------------------------
# The writing assistant — OPTIONAL
#
# With it, each network's version of a post is drafted. Without it the Command
# Centre still works: the text is fitted to each platform's limit on a sentence
# boundary, never mid-word, and the response says plainly that it was fitted
# rather than rewritten.
#
# Its brief forbids inventing accreditation, rankings, student numbers,
# employment rates, partnerships, awards and campus locations — a generated
# sentence becomes a statement BY THE UNIVERSITY the moment it is published
# under its name.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
