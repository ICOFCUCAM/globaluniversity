# ---------------------------------------------------------------------------
# ICOF Global University — environment
#
# Copy to .env.local for development, and set the same variables in the Vercel
# project for production. Nothing here has a default that is safe to ship: the
# fallbacks in the code exist so the app keeps running during the switchover,
# not because they are correct.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# The Supabase project. Both variables must point at the SAME project: the
# browser client and the approval route read the URL from one place precisely
# so an account cannot be created in one database while a status is updated in
# another.
# These two now default to the university's project in code, so they only need
# setting to point a deployment somewhere else — a staging database, say.
NEXT_PUBLIC_SUPABASE_URL=https://bhpsftesricwotkziokd.supabase.co

# The anon / publishable key. This is public by design — it reaches every
# visitor's browser — and is safe there ONLY because row-level security decides
# what it can read. Find it under Project Settings → API → Project API keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_lQm8dFmj8PnQinSZooQbVg_WAfKJcGS

# The service role key. NEVER prefix this NEXT_PUBLIC_, never commit it, and
# never paste it into a client component. It bypasses row-level security on
# every table in the database. It is used in exactly one place —
# src/app/api/admissions/approve/route.ts — to create a student's auth account
# at the moment the Registrar approves them. Without it, approval refuses
# rather than silently creating no account.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email -----------------------------------------------------------------
# Used for the application notification to Admissions and for the welcome email
# carrying a new student's credentials. If these are unset the account is still
# created, but the applicant is not told and the desk warns the Registrar.
# cPanel mail for iguc.net. Port 465 means implicit TLS; the code sets
# secure:true only for 465, so use 465 or 587 and nothing else.
SMTP_HOST=mail.iguc.net
SMTP_PORT=465
SMTP_USER=registrar@iguc.net
SMTP_PASS=

# The address students see in the From line. Optional — defaults to SMTP_USER.
# Set it only when the authenticating mailbox differs from the address the
# university wants to be seen sending from, and only to a domain whose SPF
# authorises this mail server. A mismatch reads as forged to receiving servers,
# and a student receiving their password from an unfamiliar address has been
# handed something indistinguishable from phishing.
MAIL_FROM=

# Where a submitted application is sent.
APPLY_TO=admissions@iguc.net

# --- Site ------------------------------------------------------------------
# Used to build the portal link inside the welcome email.
SITE_URL=https://iguc.net

# --- Demo ------------------------------------------------------------------
# Set to 'true' ONLY in a non-production environment. It enables one-click
# demo logins in the portal, which bypass authentication entirely.
NEXT_PUBLIC_ENABLE_DEMO=false
